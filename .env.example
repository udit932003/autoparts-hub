# PostgreSQL connection string
# Local example:  postgresql://postgres:postgres@localhost:5432/autoparts?schema=public
# Free cloud DB:  Neon (neon.tech) / Supabase / Railway -> paste their connection string here
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoparts?schema=public"

# Admin login credentials (used by the dashboard auth)
ADMIN_EMAIL="admin@autoparts.com"
ADMIN_PASSWORD="admin123"

# Secret used to sign the admin session cookie (any long random string)
AUTH_SECRET="change-this-to-a-long-random-secret-string"
